# Tushare API Token (required for market data)
TUSHARE_TOKEN=your_tushare_token_here
ts_token=your_tushare_token_here
SINGLE_USER_MODE=0
ADMIN_TOKEN=change_me_to_a_long_random_admin_token

# AI 简报使用的工作站 sglang（OpenAI 兼容接口）。docker-compose 默认 http://host.docker.internal:18100，
# 本地直接运行后端时默认 http://127.0.0.1:18100
# SGLANG_BASE_URL=http://host.docker.internal:18100
# SGLANG_MODEL=qwen
